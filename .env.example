# ──────────────────────────────────────
#  Doris 连接配置 (内网)
# ──────────────────────────────────────
DORIS_HOST=your_doris_host
DORIS_PORT=6030
DORIS_USER=your_doris_user
DORIS_PASSWORD=your_doris_password
DORIS_DATABASE=your_database

# 后端 API 端口
API_PORT=3001

# 实例视图单次查询最大行数 (防止大数据量撑爆浏览器)
MAX_QUERY_ROWS=200
# 实例视图图谱最大节点数
MAX_INSTANCE_NODES=150

# ──────────────────────────────────────
#  NebulaGraph 连接配置 (本地 Docker)
# ──────────────────────────────────────
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=ontology_playground
# nebula-console 可执行文件路径（留空则使用 PATH 中的 nebula-console）
NEBULA_CONSOLE_PATH=nebula-console
# Docker 模式下 console 所在的容器主机名（留空则使用本地模式）
NEBULA_DOCKER_HOST=graphd0
NEBULA_DOCKER_CONSOLE=nebula-console
